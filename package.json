{
    "name": "@gander-tools/nms-lib",
    "description": "NMS Calc Library",
    "type": "commonjs",
    "version": "0.0.0",
    "keywords": [
        "nomanssky",
        "No Man's Sky",
        "calculator"
    ],
    "engines": {
        "node": "^26.0.0"
    },
    "sideEffects": false,
    "author": "Adam Gąsowski",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/gander-tools/nms-lib/issues"
    },
    "homepage": "https://github.com/gander-tools/nms-lib",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        },
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "check": "biome check",
        "check:fix": "biome check --write",
        "format": "biome format",
        "format:fix": "biome format --write",
        "lint": "biome lint",
        "lint:fix": "biome lint --write",
        "prepack": "pkgroll --clean-dist --sourcemap --minify",
        "publint": "publint --pack auto",
        "release": "release-it --only-version",
        "test": "vitest --run",
        "test:coverage": "vitest --coverage",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.6",
        "@release-it/bumper": "8.0.1",
        "@types/bun": "1.4.4",
        "@types/node": "26.6.6",
        "@typescript/typescript6": "6.0.2",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/ui": "5.1.0",
        "@vue/reactivity": "3.5.45",
        "git-cliff": "2.14.2",
        "lefthook": "2.2.2",
        "pkgroll": "2.29.0",
        "publint": "0.3.25",
        "release-it": "21.1.2",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@vue/reactivity": "^3.0.0",
        "typescript": "^5.0.0 || ^7.0.0"
    }
}
